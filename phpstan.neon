# PHPStan at the highest level. phpstan-baseline.neon lists the violations there were when the CI
# started (2026-10-21, written by glitchr-studio/ci's baseline workflow), re-generated on 2026-11-09 with the
# debt left by the moves of omnisense/omnibase's plan "omnibase agnostic", to be paid down gradually: the CI
# fails on any other. Fix one, then drop its entry.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
    # omnibase's part (Omnibridge\Symfony\Omnibase\, moved from omnisense/omnibase by its plan "omnibase
    # agnostic", steps F5 to S) extends and calls the core's classes, which this package does not install
    # (the core's sites require it): PHPStan cannot read a class whose parent or interface is absent, nor put
    # that in a baseline. It runs with the core, in the core's harness - as omnibridge/doctrine's src/Omnibase.
    excludePaths:
        - src/Omnibase
    reportUnmatchedIgnoredErrors: false
