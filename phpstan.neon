# PHPStan at the highest level. phpstan-baseline.neon lists the violations there were when the CI
# started (2026-10-21, written by glitchr-studio/ci's baseline workflow), re-generated on 2026-11-09 with the
# debt left by the moves of omnisense/omnibase's plan "omnibase agnostic", to be paid down gradually: the CI
# fails on any other. Fix one, then drop its entry.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
    # omnibase's part (the classes this package declares under Base\, src/Base, and their plumbing, src/Omnibase)
    # extends and calls the core's classes, which this package does not install (the core's sites require it): PHPStan
    # cannot read a class whose parent or interface is absent, nor put that in a baseline. It is analysed with the
    # core, by omnisense/omnibase's phpstan.neon (its CI's package job, from vendor/). tests/Omnibase tests that part
    # on the core's kernel (the omnibase harness), so it is set aside too.
    excludePaths:
        - src/Base
        - src/Omnibase
        - tests/Omnibase
    reportUnmatchedIgnoredErrors: false
