# PHPStan at the highest level. phpstan-baseline.neon lists the violations there were when the CI
# started (2026-10-21, written by glitchr-studio/ci's baseline workflow), re-generated on 2026-11-09 with the
# debt left by the moves of omnisense/omnibase's plan "omnibase agnostic", to be paid down gradually: the CI
# fails on any other. Fix one, then drop its entry.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
    # omnibase's part (the classes this package declares under Base\, src/Base, and their plumbing, src/Omnibase)
    # extends and calls the core's classes, which this package does not install (the core's sites require it): PHPStan
    # cannot read a class whose parent or interface is absent, nor put that in a baseline. It is analysed with the
    # core, by omnisense/omnibase's phpstan.neon (its CI's package job, from vendor/). tests/Omnibase tests that part
    # on the core's kernel (the omnibase harness), so it is set aside too.
    excludePaths:
        - src/Base
        - src/Omnibase
        - tests/Omnibase
        # The same for the cases written on the core's classes, skipped without omnisense/omnibase, and for their
        # fixtures that extend those classes or carry its Base\Mapping attributes.
        - tests/CoreAccessTokensTest.php
        - tests/SignInConnectionTest.php
        - tests/VisitorTimezoneTest.php
        - tests/Fixtures/Host/Entity
        - tests/Fixtures/Host/Repository
        - tests/Fixtures/Host/UserLoaderUsers.php
        - tests/EntitiesDiscoveryTest.php
        - tests/SchemaUpdateCommandTest.php
        - tests/Fixtures/Package
        # A class whose parent package is absent, on purpose: what DiscoveryPass never loads (DiscoveryPassTest).
        - tests/Fixtures/Excluded
    ignoreErrors:
        # HostConfigurationTest boots one host for every case: the cases on the core's registries are skipped without
        # omnisense/omnibase, and HostExtension registers those classes only where class_exists() finds them.
        -
            identifier: class.notFound
            paths:
                - tests/HostConfigurationTest.php
                - tests/Fixtures/Host/HostExtension.php
    reportUnmatchedIgnoredErrors: false
